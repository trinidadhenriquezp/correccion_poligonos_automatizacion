import arcpy, os, glob, shutil, tkinter as tk
from tkinter import ttk, messagebox, filedialog

# === FUNCIÓN PRINCIPAL ===
def run_process():
    try:
        base = folder_var.get().strip()
        if not base or not os.path.isdir(base):
            messagebox.showwarning("Advertencia", "Por favor, seleccione una carpeta válida.")
            return

        # === VALIDAR EXISTENCIA DE "polígono corregido" ===
        salida_folder_final = os.path.join(base, "polígono corregido")
        if os.path.exists(salida_folder_final):
            messagebox.showerror(
                "Carpeta existente",
                f"La carpeta '{salida_folder_final}' ya existe.\n\n"
                f"Por favor, elimine o renombre esa carpeta antes de continuar."
            )
            return

        # === BUSCAR SHAPEFILES ===
        shp_list = glob.glob(os.path.join(base, '*.shp'))
        if not shp_list:
            messagebox.showerror("Error", "No se encontró ningún archivo .shp en la carpeta seleccionada.")
            return
        elif len(shp_list) > 1:
            messagebox.showerror(
                "Error",
                f"Se encontraron {len(shp_list)} archivos .shp en la carpeta.\n\n"
                f"Debe existir exactamente UN (1) shapefile para continuar."
            )
            return

        nombre_shp = os.path.basename(shp_list[0])
        input_shp = os.path.join(base, nombre_shp)
        print(f"🔍 Shapefile encontrado: {input_shp}")

        # === CARPETA TEMPORAL ===
        salida_folder = os.path.join(base, "procesados")
        os.makedirs(salida_folder, exist_ok=True)

        # === CREA GDB TEMPORAL ===
        gdb_temp = os.path.join(salida_folder, "temp.gdb")
        if not arcpy.Exists(gdb_temp):
            arcpy.management.CreateFileGDB(salida_folder, "temp.gdb")

        # === CONVERTIR A 2D (desactivar Z y M) ===
        arcpy.env.outputZFlag = "Disabled"
        arcpy.env.outputMFlag = "Disabled"
        arcpy.conversion.FeatureClassToFeatureClass(input_shp, gdb_temp, "poly2D")

        # === REPROYECCIÓN A ZONA SELECCIONADA ===
        zona = zone_var.get()
        wkid = 32718 if zona == "18S" else 32719
        sr = arcpy.SpatialReference(wkid)
        fc_2d = os.path.join(gdb_temp, "poly2D")
        fc_reproy = os.path.join(gdb_temp, f"poly{zona}")
        arcpy.management.Project(fc_2d, fc_reproy, sr)
        print(f"✅ Reproyección completa a UTM {zona} (WKID {wkid})")

        # === CONFIGURA SALIDA FINAL ===
        os.makedirs(salida_folder_final, exist_ok=True)
        partes_nombre = nombre_shp.split('.')
        nombre_salida = partes_nombre[0] + '_PF.' + partes_nombre[1]

        # === EXPORTAR COMO SHAPE FINAL ===
        salida_shp = os.path.join(salida_folder_final, nombre_salida)
        arcpy.conversion.FeatureClassToFeatureClass(fc_reproy, salida_folder_final, partes_nombre[0] + '_PF')
        print(f"✅ Shapefile exportado: {salida_shp}")

        # === CREAR CAMPOS ESTÁNDAR ===
        lista_objetivo = ["Nombre", "Número", "Región", "sup_poly"]
        tipos_objetivo = ["TEXT", "SHORT", "TEXT", "DOUBLE"]
        campos_objetivo = list(zip(lista_objetivo, tipos_objetivo))
        todos = [f.name for f in arcpy.ListFields(salida_shp)]

        for nombre, tipo in campos_objetivo:
            if nombre not in todos:
                arcpy.management.AddField(salida_shp, nombre, tipo)
        print("✅ Campos estándar agregados")

        # === CALCULAR sup_poly (área geodésica en hectáreas) ===
        arcpy.management.CalculateGeometryAttributes(
            salida_shp,
            [["sup_poly", "AREA_GEODESIC"]],
            area_unit="HECTARES"
        )
        print("✅ Campo sup_poly calculado (área geodésica en ha)")

        # === ELIMINAR CAMPOS SOBRANTES ===
        campos_permitidos = ['OID', 'OBJECTID', 'FID', 'Shape', *lista_objetivo]
        eliminar = [f for f in todos if f not in campos_permitidos]
        if eliminar:
            arcpy.management.DeleteField(salida_shp, eliminar)
            print(f"🧹 Campos eliminados: {eliminar}")
        else:
            print("No se encontraron campos extra para eliminar.")

        # === VERIFICAR RESULTADO FINAL ===
        desc_final = arcpy.Describe(salida_shp)
        result = f"""
✅ FINALIZADO:
- Geometría: {desc_final.shapeType}
- Z: {desc_final.hasZ}, M: {desc_final.hasM}
- SR: {desc_final.spatialReference.name}
- Archivo final: {salida_shp}
"""
        print(result)

        # === LIMPIEZA: eliminar carpeta procesados ===
        if os.path.exists(salida_folder):
            try:
                shutil.rmtree(salida_folder)
                print(f"🧹 Carpeta temporal eliminada: {salida_folder}")
            except Exception as cleanup_error:
                print(f"⚠ No se pudo eliminar {salida_folder}: {cleanup_error}")

        messagebox.showinfo("Proceso completado", result)

    except Exception as e:
        messagebox.showerror("Error", f"Ocurrió un error:\n{e}")
        print("❌ Error:", e)


# === SELECCIONAR CARPETA ===
def select_folder():
    folder = filedialog.askdirectory(title="Seleccionar carpeta base")
    if folder:
        folder_var.set(folder)


# === INTERFAZ TKINTER ===
root = tk.Tk()
root.title("Automatización ArcPy – Reproyección y Limpieza")
root.geometry("520x340")
root.resizable(False, False)

frame = ttk.Frame(root, padding=20)
frame.pack(fill="both", expand=True)

# --- Selección de carpeta ---
ttk.Label(frame, text="Carpeta base del proyecto:", font=("Segoe UI", 10)).pack(anchor="w")
folder_var = tk.StringVar()
folder_entry = ttk.Entry(frame, textvariable=folder_var, width=60)
folder_entry.pack(pady=5, side="top")
ttk.Button(frame, text="📁 Buscar...", command=select_folder).pack(pady=5)

# --- Selección de zona ---
ttk.Label(frame, text="Seleccione la zona UTM para reproyección:", font=("Segoe UI", 10)).pack(pady=(15,5))
zone_var = tk.StringVar(value="19S")
zone_combo = ttk.Combobox(frame, textvariable=zone_var, values=["18S", "19S"], state="readonly", width=10)
zone_combo.pack(pady=5)

# --- Botón ejecutar ---
ttk.Button(frame, text="▶ Ejecutar proceso", command=run_process).pack(pady=20)

# --- Info ---
ttk.Label(
    frame,
    text="Este script reproyecta, limpia y estandariza el shapefile.\n"
         "Debe existir exactamente un (.shp) en la carpeta seleccionada.\n"
         "ArcGIS Pro debe estar instalado y licenciado.",
    font=("Segoe UI", 9),
    justify="center"
).pack(pady=5)

root.mainloop()
